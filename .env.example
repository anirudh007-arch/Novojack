# Supabase (client + server) — from your Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — chat, vision/OCR, and TTS (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google OAuth client — same Client ID/Secret registered as the "Google"
# provider in Supabase Auth. Used server-side to refresh Gmail/Calendar/Tasks
# access tokens after a user connects their Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth App (https://github.com/settings/developers -> New OAuth App).
# Authorization callback URL must be exactly "<your origin>/settings".
# The client ID is public (sent to the browser to build the authorize URL);
# the secret is server-only, used for the token exchange.
VITE_GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Spotify app (https://developer.spotify.com/dashboard -> Create app).
# Redirect URI must be exactly "<your origin>/settings". Playback control
# requires the connecting user to have Spotify Premium and an already-open
# device (phone/desktop app) — there's no way to "wake up" a device remotely.
VITE_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
