# Supabase (client + server) — from your Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — chat, vision/OCR, and TTS (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google OAuth client — same Client ID/Secret registered as the "Google"
# provider in Supabase Auth. Used server-side to refresh Gmail/Calendar access
# tokens after a user connects their Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
